{
  "name": "gopher-nav",
  "displayName": "Gopher Nav",
  "description": "GoLand 风格的 Go 接口导航：接口实现查找、实现反查、接口/结构体/方法互跳（内置 Go 语法解析与索引；F12 定义跳转交由 gopls）",
  "version": "1.1.0",
  "publisher": "eof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ainiou/go-navigator.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "go",
    "golang",
    "navigation",
    "interface",
    "implementation"
  ],
  "activationEvents": [
    "onLanguage:go",
    "workspaceContains:**/go.mod"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.80.0",
    "typescript": "^5.4.5"
  },
  "contributes": {
    "languages": [
      {
        "id": "go",
        "aliases": [
          "Go",
          "go"
        ],
        "extensions": [
          ".go"
        ]
      }
    ],
    "commands": [
      {
        "command": "goNavigator.findAllImplementations",
        "title": "查找所有实现",
        "category": "Gopher Nav"
      },
      {
        "command": "goNavigator.showImplementations",
        "title": "查看实现列表",
        "category": "Gopher Nav"
      },
      {
        "command": "goNavigator.showInterfaces",
        "title": "查看实现的接口",
        "category": "Gopher Nav"
      },
      {
        "command": "goNavigator.reindex",
        "title": "重建 Go 索引",
        "category": "Gopher Nav"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "goNavigator.findAllImplementations",
          "when": "editorLangId == go",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Gopher Nav",
      "properties": {
        "goNavigator.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "在接口/结构体/方法上方显示实现个数与跳转按钮（GoLand 风格）。"
        },
        "goNavigator.indexVendor": {
          "type": "boolean",
          "default": false,
          "description": "是否把 vendor 目录中的 Go 源码纳入索引。"
        },
        "goNavigator.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "description": "单个 Go 文件的最大索引体积（KB），超过则跳过，避免超大生成文件拖慢索引。"
        },
        "goNavigator.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "索引时额外排除的 glob 规则。"
        }
      }
    }
  }
}
